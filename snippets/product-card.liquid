{%- liquid
  assign card_product  = card_product | default: product
  assign show_vendor   = show_vendor | default: false
  assign second_image  = card_product.images[1]
-%}

<article class="product-card" aria-label="{{ card_product.title | escape }}">

  <div class="product-card__media-wrap">
    <a href="{{ card_product.url }}" class="product-card__media-link" tabindex="-1" aria-hidden="true">
      <div class="product-card__media">

        {%- if card_product.featured_image -%}
          {%- assign card_img_alt = card_product.featured_image.alt | default: card_product.title | escape -%}
          {{ card_product.featured_image | image_url: width: 800 | image_tag:
            widths: '400, 600, 800',
            loading: 'lazy',
            width: card_product.featured_image.width,
            height: card_product.featured_image.height,
            alt: card_img_alt,
            class: 'product-card__img product-card__img--primary'
          }}
          {%- if second_image -%}
            {%- assign second_img_alt = second_image.alt | default: card_product.title | escape -%}
            {{ second_image | image_url: width: 800 | image_tag:
              widths: '400, 600, 800',
              loading: 'lazy',
              width: second_image.width,
              height: second_image.height,
              alt: second_img_alt,
              class: 'product-card__img product-card__img--secondary'
            }}
          {%- endif -%}
        {%- else -%}
          <div class="product-card__no-image"></div>
        {%- endif -%}

        {%- if card_product.compare_at_price > card_product.price -%}
          <span class="product-card__badge">Sale</span>
        {%- elsif card_product.available == false -%}
          <span class="product-card__badge product-card__badge--sold-out">Sold out</span>
        {%- endif -%}

      </div>
    </a>

    {%- if card_product.has_only_default_variant and card_product.available -%}
      <div class="product-card__quick-add">
        <button
          type="button"
          class="product-card__quick-add-btn"
          data-variant-id="{{ card_product.selected_or_first_available_variant.id }}"
          aria-label="Quick add {{ card_product.title | escape }} to cart"
        >Quick add</button>
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    {%- if show_vendor and card_product.vendor != blank -%}
      <p class="product-card__vendor">{{ card_product.vendor }}</p>
    {%- endif -%}

    <h3 class="product-card__title">
      <a href="{{ card_product.url }}" class="product-card__title-link">{{ card_product.title }}</a>
    </h3>

    <div class="product-card__price">
      {%- if card_product.compare_at_price > card_product.price -%}
        <s class="product-card__price-compare">{{ card_product.compare_at_price | money }}</s>
        <span class="product-card__price-sale">{{ card_product.price | money }}</span>
      {%- elsif card_product.price_varies -%}
        <span>From {{ card_product.price_min | money }}</span>
      {%- else -%}
        <span>{{ card_product.price | money }}</span>
      {%- endif -%}
    </div>
  </div>

</article>
