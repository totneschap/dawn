{% comment %}
  Renders a premium megamenu for the header.

  Usage:
  {% render 'header-mega-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}

          {%- comment -%} Find a promo block attached to this top-level link {%- endcomment -%}
          {%- assign promo_block = nil -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'mega_menu_promo' and block.settings.menu_item == link.handle -%}
              {%- assign promo_block = block -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} Pre-scan child links to detect if any have images {%- endcomment -%}
          {%- assign has_child_images = false -%}
          {%- for childlink in link.links -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'mega_menu_item_image' and block.settings.menu_item == link.handle and block.settings.child_item == childlink.handle and block.settings.image != blank -%}
                {%- assign has_child_images = true -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if childlink.type == 'collection_link' and childlink.object.image != blank -%}
              {%- assign has_child_images = true -%}
            {%- endif -%}
          {%- endfor -%}

          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
                aria-expanded="false"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                <span class="mega-menu__caret" aria-hidden="true">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >
                <div class="mega-menu__inner{% unless section.settings.full_width %} page-width{% endunless %}{% if promo_block and has_child_images == false %} mega-menu__inner--has-promo{% elsif promo_block %} mega-menu__inner--has-promo{% endif %}">

                  <ul
                    class="mega-menu__list{% if link.levels == 1 and has_child_images == false %} mega-menu__list--condensed{% endif %}{% if has_child_images %} mega-menu__list--image-grid{% endif %}"
                    role="list"
                  >
                    {%- for childlink in link.links -%}
                      {%- comment -%} Look for custom image override for this child link {%- endcomment -%}
                      {%- assign child_img = nil -%}
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'mega_menu_item_image' and block.settings.menu_item == link.handle and block.settings.child_item == childlink.handle and block.settings.image != blank -%}
                          {%- assign child_img = block.settings.image -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if child_img == nil and childlink.type == 'collection_link' and childlink.object.image != blank -%}
                        {%- assign child_img = childlink.object.image -%}
                      {%- endif -%}

                      <li class="mega-menu__column">
                        {%- if has_child_images -%}
                          <a
                            id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                            href="{{ childlink.url }}"
                            class="mega-menu__card link{% if childlink.current %} mega-menu__card--active{% endif %}"
                            {% if childlink.current %}aria-current="page"{% endif %}
                          >
                            <div class="mega-menu__card-image-wrapper">
                              {%- if child_img != blank -%}
                                {{
                                  child_img
                                  | image_url: width: 400
                                  | image_tag:
                                    class: 'mega-menu__card-image',
                                    loading: 'lazy',
                                    widths: '200, 300, 400',
                                    sizes: '(min-width: 990px) 16rem, 40vw'
                                }}
                              {%- else -%}
                                <div class="mega-menu__card-image-placeholder"></div>
                              {%- endif -%}
                            </div>
                            <span class="mega-menu__card-label">{{ childlink.title | escape }}</span>
                          </a>
                        {%- else -%}
                          <a
                            id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                            href="{{ childlink.url }}"
                            class="mega-menu__link mega-menu__link--level-2 link{% if childlink.current %} mega-menu__link--active{% endif %}"
                            {% if childlink.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{ childlink.title | escape }}
                          </a>
                          {%- if childlink.links != blank -%}
                            <ul class="mega-menu__sublist list-unstyled" role="list">
                              {%- for grandchildlink in childlink.links -%}
                                <li>
                                  <a
                                    id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                    href="{{ grandchildlink.url }}"
                                    class="mega-menu__link link{% if grandchildlink.current %} mega-menu__link--active{% endif %}"
                                    {% if grandchildlink.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {{ grandchildlink.title | escape }}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>

                  {%- if promo_block -%}
                    <div class="mega-menu__promo" {{ promo_block.shopify_attributes }}>

                      {%- if promo_block.settings.image != blank -%}
                        <a
                          href="{{ promo_block.settings.button_url | default: '#' }}"
                          class="mega-menu__promo-image-link"
                          {% if promo_block.settings.button_label == blank %}aria-hidden="true" tabindex="-1"{% endif %}
                        >
                          {{
                            promo_block.settings.image
                            | image_url: width: 600
                            | image_tag:
                              class: 'mega-menu__promo-image',
                              loading: 'lazy',
                              widths: '300, 400, 600',
                              sizes: '(min-width: 990px) 28rem, 50vw'
                          }}
                          {%- if promo_block.settings.badge_text != blank -%}
                            <span class="mega-menu__promo-badge">{{ promo_block.settings.badge_text | escape }}</span>
                          {%- endif -%}
                        </a>
                      {%- elsif promo_block.settings.badge_text != blank -%}
                        <span class="mega-menu__promo-badge mega-menu__promo-badge--standalone">
                          {{ promo_block.settings.badge_text | escape }}
                        </span>
                      {%- endif -%}

                      <div class="mega-menu__promo-body">
                        {%- if promo_block.settings.heading != blank -%}
                          <p class="mega-menu__promo-heading">{{ promo_block.settings.heading | escape }}</p>
                        {%- endif -%}
                        {%- if promo_block.settings.text != blank -%}
                          <p class="mega-menu__promo-text">{{ promo_block.settings.text | escape }}</p>
                        {%- endif -%}
                        {%- if promo_block.settings.button_label != blank -%}
                          <a
                            href="{{ promo_block.settings.button_url | default: '#' }}"
                            class="mega-menu__promo-btn"
                          >
                            {{ promo_block.settings.button_label | escape }}
                            <span class="mega-menu__promo-btn-arrow" aria-hidden="true">→</span>
                          </a>
                        {%- endif -%}
                      </div>

                    </div>
                  {%- endif -%}

                </div>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
