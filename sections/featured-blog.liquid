{%- assign blog_source = section.settings.blog -%}

<div class="featured-blog full-width color-{{ section.settings.color_scheme }}">

  <!-- Header -->
  {%- if section.settings.heading != blank or section.settings.subtext != blank or section.settings.view_all -%}
    <div class="featured-blog__header">
      <div class="featured-blog__header-text">
        {%- if section.settings.heading != blank -%}
          <h2 class="featured-blog__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="featured-blog__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.view_all and blog_source != blank -%}
        <a href="{{ blog_source.url }}" class="featured-blog__view-all">
          {{ section.settings.view_all_label | default: 'View all' }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <!-- Article grid -->
  {%- if blog_source != blank and blog_source.articles.size > 0 -%}
    <ul
      class="featured-blog__grid"
      role="list"
      style="--fb-cols: {{ section.settings.columns_desktop }};"
    >
      {%- assign limit = section.settings.articles_to_show -%}
      {%- for article in blog_source.articles limit: limit -%}
        <li class="featured-blog__item">
          <article class="article-card">

            {%- if article.image -%}
              <a href="{{ article.url }}" class="article-card__media-link" tabindex="-1" aria-hidden="true">
                <div class="article-card__media">
                  {%- assign article_img_alt = article.image.alt | default: article.title | escape -%}
                  {{ article.image | image_url: width: 800 | image_tag:
                    widths: '400, 600, 800',
                    loading: 'lazy',
                    width: article.image.width,
                    height: article.image.height,
                    alt: article_img_alt,
                    class: 'article-card__img'
                  }}
                </div>
              </a>
            {%- endif -%}

            <div class="article-card__info">
              {%- if section.settings.show_date or section.settings.show_author -%}
                <p class="article-card__meta">
                  {%- if section.settings.show_date -%}
                    <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                      {{- article.published_at | date: '%d %b %Y' -}}
                    </time>
                  {%- endif -%}
                  {%- if section.settings.show_date and section.settings.show_author -%}
                    <span aria-hidden="true">&middot;</span>
                  {%- endif -%}
                  {%- if section.settings.show_author -%}
                    <span>{{ article.author }}</span>
                  {%- endif -%}
                </p>
              {%- endif -%}

              <h3 class="article-card__title">
                <a href="{{ article.url }}" class="article-card__title-link">{{ article.title }}</a>
              </h3>

              {%- if section.settings.show_excerpt and article.excerpt_or_content != blank -%}
                <p class="article-card__excerpt">
                  {{ article.excerpt_or_content | strip_html | truncate: 120 }}
                </p>
              {%- endif -%}

              <a href="{{ article.url }}" class="article-card__read-more">
                {{ section.settings.read_more_label | default: 'Read more' }}
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>

          </article>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.view_all and blog_source != blank -%}
      <div class="featured-blog__footer">
        <a href="{{ blog_source.url }}" class="button button--outline">
          {{ section.settings.view_all_label | default: 'View all' }}
        </a>
      </div>
    {%- endif -%}

  {%- elsif blog_source == blank -%}
    <!-- Placeholder in theme editor -->
    <ul
      class="featured-blog__grid"
      role="list"
      style="--fb-cols: {{ section.settings.columns_desktop }};"
    >
      {%- for i in (1..section.settings.articles_to_show) -%}
        <li class="featured-blog__item">
          <div class="featured-blog__placeholder-card">
            <div class="featured-blog__placeholder-media"></div>
            <div class="featured-blog__placeholder-info">
              <div class="featured-blog__placeholder-meta"></div>
              <div class="featured-blog__placeholder-title"></div>
              <div class="featured-blog__placeholder-title featured-blog__placeholder-title--short"></div>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

</div>

{% stylesheet %}

.featured-blog {
  background-color: var(--color-background);
  color: var(--color-text);
  padding: var(--section-spacing, 6rem) var(--page-margin, 2rem);
}

/* Header */
.featured-blog__header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 2rem;
  margin-bottom: 4rem;
  flex-wrap: wrap;
  max-width: var(--page-width, 1200px);
}

.featured-blog__heading {
  font-size: clamp(var(--text-h3, 2.8rem), 4vw, var(--text-h2, 3.6rem));
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: var(--font-heading--letter-spacing, 0);
}

.featured-blog__subtext {
  font-size: 1.4rem;
  opacity: 0.55;
  margin-top: 1rem;
  max-width: 48ch;
}

.featured-blog__view-all {
  flex-shrink: 0;
  font-size: 1.2rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-decoration: none;
  color: currentColor;
  border-bottom: 1px solid currentColor;
  padding-bottom: 0.2rem;
  white-space: nowrap;
  transition: opacity 0.2s ease;
}
.featured-blog__view-all:hover { opacity: 0.55; }

/* Grid */
.featured-blog__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 4rem 2.4rem;
}

@media screen and (min-width: 750px) {
  .featured-blog__grid {
    grid-template-columns: repeat(var(--fb-cols, 3), 1fr);
    gap: 4rem 2.4rem;
  }
}

/* Footer view all (mobile) */
.featured-blog__footer {
  text-align: center;
  margin-top: 4rem;
}

@media screen and (min-width: 750px) {
  .featured-blog__footer { display: none; }
}

/* Article card */
.article-card {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  height: 100%;
}

.article-card__media-link {
  display: block;
  text-decoration: none;
  overflow: hidden;
}

.article-card__media {
  aspect-ratio: 3 / 2;
  overflow: hidden;
  border-radius: var(--style-card-radius, 0);
  background: rgba(0, 0, 0, 0.05);
}

.article-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}

.article-card__media-link:hover .article-card__img {
  transform: scale(1.03);
}

.article-card__info {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  flex: 1;
}

.article-card__meta {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  font-size: 1.2rem;
  opacity: 0.5;
  letter-spacing: 0.03em;
}

.article-card__title {
  font-size: clamp(1.6rem, 2.5vw, 2rem);
  font-weight: 400;
  line-height: 1.25;
}

.article-card__title-link {
  text-decoration: none;
  color: currentColor;
}

.article-card__title-link:hover {
  text-decoration: underline;
  text-underline-offset: 0.3em;
}

.article-card__excerpt {
  font-size: 1.4rem;
  line-height: 1.65;
  opacity: 0.7;
}

.article-card__read-more {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 1.2rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: currentColor;
  text-decoration: none;
  margin-top: auto;
  padding-top: 0.4rem;
  transition: opacity 0.15s ease;
}

.article-card__read-more:hover { opacity: 0.65; }

/* Placeholders */
.featured-blog__placeholder-card {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.featured-blog__placeholder-media {
  aspect-ratio: 3 / 2;
  background: rgba(0, 0, 0, 0.07);
  border-radius: var(--style-card-radius, 0);
}

.featured-blog__placeholder-info {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.featured-blog__placeholder-meta {
  height: 1.1rem;
  width: 35%;
  background: rgba(0, 0, 0, 0.05);
}

.featured-blog__placeholder-title {
  height: 1.8rem;
  width: 85%;
  background: rgba(0, 0, 0, 0.07);
}

.featured-blog__placeholder-title--short { width: 55%; }

{% endstylesheet %}

{% schema %}
{
  "name": "Featured blog",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the journal"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "header",
      "content": "Blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Articles to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "header",
      "content": "Card content"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more label",
      "default": "Read more"
    },
    {
      "type": "header",
      "content": "View all"
    },
    {
      "type": "checkbox",
      "id": "view_all",
      "label": "Show \"View all\" button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "View all posts"
    }
  ],
  "presets": [
    {
      "name": "Featured blog",
      "settings": {
        "heading": "From the journal",
        "articles_to_show": 3,
        "columns_desktop": "3",
        "show_date": true,
        "show_excerpt": true,
        "view_all": true
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
