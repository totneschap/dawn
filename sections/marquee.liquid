{{ 'section-marquee.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #Marquee-{{ section.id }} {
    --marquee-speed: {{ section.settings.speed }}s;
    --marquee-gap: {{ section.settings.gap }}rem;
    font-size: calc(var(--font-body-size, 1.5rem) * {{ section.settings.font_size | divided_by: 100.0 }}rem);
  }
{%- endstyle -%}

<div
  class="marquee-section color-{{ section.settings.color_scheme }} gradient"
  id="Marquee-{{ section.id }}"
>
  <div class="marquee-track-outer" aria-hidden="true">
    <div class="marquee-track">
      {%- for iteration in (1..2) -%}
        <span class="marquee-set">
          {%- for block in section.blocks -%}
            <span class="marquee-item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="marquee-item__link">
                  {{- block.settings.text | escape -}}
                </a>
              {%- else -%}
                {{- block.settings.text | escape -}}
              {%- endif -%}
              <span class="marquee-sep" aria-hidden="true">{{ section.settings.separator }}</span>
            </span>
          {%- endfor -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.blocks.size == 0 -%}
    <div class="marquee-track-outer" aria-hidden="true">
      <div class="marquee-track">
        {%- for iteration in (1..2) -%}
          <span class="marquee-set">
            <span class="marquee-item">New Collection <span class="marquee-sep">✦</span></span>
            <span class="marquee-item">Free Shipping Over £100 <span class="marquee-sep">✦</span></span>
            <span class="marquee-item">Shop the Edit <span class="marquee-sep">✦</span></span>
          </span>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Marquee",
  "class": "section",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator character",
      "default": "✦"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 25,
      "info": "Lower = faster"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 80,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Item spacing",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "rem",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Text item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New Arrivals"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "New Arrivals" } },
        { "type": "item", "settings": { "text": "Free Shipping Over £100" } },
        { "type": "item", "settings": { "text": "Shop the Edit" } },
        { "type": "item", "settings": { "text": "Curated Fashion" } }
      ]
    }
  ]
}
{% endschema %}
