{%- liquid
  assign search_type   = search.types | join: ','
  assign per_page      = section.settings.results_per_page | plus: 0

  if search.types.size > 1
    assign is_all_active = true
  endif
  if search_type == 'product'
    assign is_products_active = true
  endif
  if search_type == 'article'
    assign is_articles_active = true
  endif
  if search_type == 'page'
    assign is_pages_active = true
  endif
-%}

<div class="search-page color-{{ section.settings.color_scheme }}">

  <!-- ===== SEARCH HERO ===== -->
  <div class="search-hero">
    {%- if section.settings.show_heading -%}
      <h1 class="search-hero__heading">{{ section.settings.heading | default: 'Search' }}</h1>
    {%- endif -%}

    <form
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      class="search-hero__form"
    >
      {%- comment -%}Preserve type filter when re-searching from the same type view{%- endcomment -%}
      {%- if search.performed and search.types.size == 1 -%}
        <input type="hidden" name="type" value="{{ search.types.first }}">
      {%- endif -%}

      <div class="search-hero__field">
        <span class="search-hero__icon" aria-hidden="true" style="--icon-stroke-width: 1.5px">
          {{- 'icon-search.svg' | inline_asset_content -}}
        </span>
        <input
          type="search"
          name="q"
          id="search-input"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
          class="search-hero__input"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label="{{ 'search.placeholder' | t }}"
        >
        {%- if search.performed and search.terms != blank -%}
          <button
            type="button"
            class="search-hero__clear"
            id="search-clear"
            aria-label="Clear search"
            style="--icon-stroke-width: 1.5px"
          >{{- 'icon-close.svg' | inline_asset_content -}}</button>
        {%- endif -%}
      </div>

      <button type="submit" class="button search-hero__btn">
        {{- 'search.submit' | t -}}
      </button>
    </form>
  </div>

  {%- if search.performed -%}
    <div class="search-body">

      <!-- Meta: count + type tabs -->
      <div class="search-meta">
        <p class="search-meta__count" aria-live="polite" aria-atomic="true">
          {%- if search.results_count == 0 -%}
            {{ 'search.no_results_html' | t: terms: search.terms }}
          {%- else -%}
            {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
          {%- endif -%}
        </p>

        <div class="search-meta__tabs" role="list">
          <a
            href="{{ routes.search_url }}?q={{ search.terms | url_encode }}"
            class="search-meta__tab{% if is_all_active %} is-active{% endif %}"
          >All</a>
          <a
            href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product"
            class="search-meta__tab{% if is_products_active %} is-active{% endif %}"
          >Products</a>
          <a
            href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=article"
            class="search-meta__tab{% if is_articles_active %} is-active{% endif %}"
          >Articles</a>
          <a
            href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=page"
            class="search-meta__tab{% if is_pages_active %} is-active{% endif %}"
          >Pages</a>
        </div>
      </div>

      {%- if search.results_count > 0 -%}

        {%- paginate search.results by per_page -%}

          <ul class="search-results" role="list">
            {%- for result in search.results -%}
              <li class="search-results__item search-results__item--{{ result.object_type }}">

                {%- case result.object_type -%}

                  {%- when 'product' -%}
                    {%- render 'product-card',
                      card_product: result,
                      show_vendor: section.settings.show_vendor
                    -%}

                  {%- when 'article' -%}
                    <article class="article-card">
                      <a
                        href="{{ result.url }}"
                        class="article-card__media-link"
                        tabindex="-1"
                        aria-hidden="true"
                      >
                        <div class="article-card__media">
                          {%- if result.image -%}
                            {%- assign result_img_alt = result.image.alt | default: result.title | escape -%}
                            {{ result.image | image_url: width: 800 | image_tag:
                              widths: '400, 600, 800',
                              loading: 'lazy',
                              width: result.image.width,
                              height: result.image.height,
                              alt: result_img_alt,
                              class: 'article-card__img'
                            }}
                          {%- else -%}
                            <div class="article-card__img--placeholder"></div>
                          {%- endif -%}
                        </div>
                      </a>
                      <div class="article-card__info">
                        <p class="article-card__meta">
                          {{- result.published_at | date: '%d %B %Y' -}}
                          {%- if result.author != blank %} &middot; {{ result.author }}{%- endif -%}
                        </p>
                        <h3 class="article-card__title">
                          <a href="{{ result.url }}" class="article-card__title-link">{{ result.title }}</a>
                        </h3>
                        {%- if result.excerpt != blank -%}
                          <p class="article-card__excerpt">
                            {{ result.excerpt | strip_html | truncate: 130 }}
                          </p>
                        {%- endif -%}
                      </div>
                    </article>

                  {%- when 'page' -%}
                    <div class="page-result">
                      <div class="page-result__body">
                        <p class="page-result__type">Page</p>
                        <h3 class="page-result__title">
                          <a href="{{ result.url }}" class="page-result__title-link">{{ result.title }}</a>
                        </h3>
                        {%- if result.content != blank -%}
                          <p class="page-result__excerpt">
                            {{ result.content | strip_html | truncate: 200 }}
                          </p>
                        {%- endif -%}
                      </div>
                      <span class="page-result__arrow" aria-hidden="true">&rarr;</span>
                    </div>

                {%- endcase -%}

              </li>
            {%- endfor -%}
          </ul>

          <!-- Pagination -->
          {%- if paginate.pages > 1 -%}
            <nav class="search-pagination" aria-label="{{ 'search.title' | t }} pagination">
              <ul class="search-pagination__list">
                {%- if paginate.previous -%}
                  <li>
                    <a
                      href="{{ paginate.previous.url }}"
                      class="search-pagination__btn search-pagination__btn--prev"
                      aria-label="Previous page"
                    >&larr;</a>
                  </li>
                {%- endif -%}

                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <li>
                      <a href="{{ part.url }}" class="search-pagination__btn">{{ part.title }}</a>
                    </li>
                  {%- elsif part.title == paginate.current_page -%}
                    <li>
                      <span
                        class="search-pagination__btn is-active"
                        aria-current="page"
                      >{{ part.title }}</span>
                    </li>
                  {%- else -%}
                    <li>
                      <span class="search-pagination__ellipsis">{{ part.title }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}

                {%- if paginate.next -%}
                  <li>
                    <a
                      href="{{ paginate.next.url }}"
                      class="search-pagination__btn search-pagination__btn--next"
                      aria-label="Next page"
                    >&rarr;</a>
                  </li>
                {%- endif -%}
              </ul>
            </nav>
          {%- endif -%}

        {%- endpaginate -%}

      {%- else -%}

        <!-- No results state -->
        <div class="search-empty">
          <p class="search-empty__message">
            Try different keywords or browse our collections.
          </p>
          <div class="search-empty__actions">
            <a href="{{ routes.all_products_collection_url }}" class="button button--outline">
              Shop all products
            </a>
          </div>
        </div>

      {%- endif -%}
    </div>
  {%- endif -%}

</div>

{% stylesheet %}

/* ================================================
   PAGE WRAPPER
   ================================================ */

.search-page {
  padding-bottom: 7rem;
  background-color: var(--color-background);
  color: var(--color-text);
}

/* ================================================
   HERO / SEARCH FORM
   ================================================ */

.search-hero {
  padding: 5rem 0 4rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rem;
  text-align: center;
}

.search-hero__heading {
  font-size: clamp(var(--text-h3, 2.8rem), 5vw, var(--text-h1, 5.6rem));
  font-weight: 400;
  line-height: 1.05;
}

.search-hero__form {
  width: 100%;
  max-width: 64rem;
  display: flex;
  gap: 1rem;
  align-items: stretch;
}

.search-hero__field {
  flex: 1;
  display: flex;
  align-items: center;
  border: 1px solid var(--color-border);
  gap: 0.8rem;
  padding: 0 1.2rem;
  min-width: 0;
}

.search-hero__field:focus-within {
  outline: 2px solid var(--color-text);
  outline-offset: -1px;
}

.search-hero__icon {
  width: 1.8rem;
  height: 1.8rem;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  opacity: 0.5;
}

.search-hero__icon svg {
  width: 1.8rem;
  height: 1.8rem;
}

.search-hero__input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  font-family: var(--font-body--family, sans-serif);
  font-size: 1.5rem;
  color: var(--color-text);
  height: 5rem;
  min-width: 0;
}

.search-hero__input::placeholder {
  opacity: 0.45;
}

.search-hero__input::-webkit-search-decoration,
.search-hero__input::-webkit-search-cancel-button { display: none; }

.search-hero__clear {
  background: none;
  border: none;
  cursor: pointer;
  width: 2rem;
  height: 2rem;
  padding: 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: currentColor;
  opacity: 0.45;
  transition: opacity 0.15s ease;
}

.search-hero__clear:hover { opacity: 1; }
.search-hero__clear svg { width: 1.6rem; height: 1.6rem; }

.search-hero__btn {
  padding: 0 2.4rem;
  flex-shrink: 0;
  height: 5.2rem;
  font-size: 1.3rem;
  white-space: nowrap;
}

@media screen and (max-width: 749px) {
  .search-hero__btn {
    padding: 0 1.6rem;
    font-size: 1.2rem;
  }
}

/* ================================================
   SEARCH BODY (constrained)
   ================================================ */

.search-body {
  display: flex;
  flex-direction: column;
  gap: 3.2rem;
}

/* ================================================
   META ROW
   ================================================ */

.search-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 1.6rem;
  justify-content: space-between;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--color-border);
}

.search-meta__count {
  font-size: 1.4rem;
  opacity: 0.65;
}

.search-meta__tabs {
  display: flex;
  gap: 0;
  border: 1px solid var(--color-border);
}

.search-meta__tab {
  padding: 0.8rem 1.6rem;
  font-size: 1.2rem;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  text-decoration: none;
  color: var(--color-text);
  opacity: 0.55;
  transition: opacity 0.15s ease, background-color 0.15s ease;
  border-right: 1px solid var(--color-border);
}

.search-meta__tab:last-child {
  border-right: none;
}

.search-meta__tab:hover {
  opacity: 1;
  background: rgba(0,0,0,0.04);
}

.search-meta__tab.is-active {
  background-color: var(--color-text);
  color: var(--color-background);
  opacity: 1;
}

/* ================================================
   RESULTS GRID
   ================================================ */

.search-results {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 3.2rem 2rem;
}

@media screen and (min-width: 750px) {
  .search-results {
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem 2.4rem;
  }
}

/* Page results span full width */
.search-results__item--page {
  grid-column: 1 / -1;
}

/* ================================================
   PRODUCT CARD  (mirrors collection section)
   ================================================ */

.product-card {
  display: flex;
  flex-direction: column;
  gap: 1.4rem;
}

.product-card__media-link {
  display: block;
  text-decoration: none;
  overflow: hidden;
}

.product-card__media {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: rgba(0,0,0,0.04);
  border-radius: var(--style-card-radius, 0);
}

.product-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}

.product-card__img--secondary {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 0.4s ease;
}

.product-card__media-wrap:hover .product-card__img--primary {
  transform: scale(1.02);
}

.product-card__media-wrap:hover .product-card__img--secondary {
  opacity: 1;
}

.product-card__no-image {
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.06);
}

.product-card__badge {
  position: absolute;
  top: 1.2rem;
  left: 1.2rem;
  background: var(--color-text);
  color: var(--color-background);
  font-size: 1rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 0.4rem 0.8rem;
}

.product-card__badge--sold-out {
  background: rgba(0,0,0,0.35);
  color: #fff;
}

.product-card__info {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.product-card__vendor {
  font-size: 1.1rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0.5;
}

.product-card__title {
  font-family: var(--font-heading--family, serif);
  font-size: 1.5rem;
  font-weight: 400;
  line-height: 1.3;
  letter-spacing: var(--font-heading--letter-spacing, 0);
}

.product-card__title-link {
  text-decoration: none;
  color: currentColor;
}

.product-card__title-link:hover {
  text-decoration: underline;
  text-underline-offset: 0.3em;
}

.product-card__price {
  font-size: 1.4rem;
  display: flex;
  align-items: baseline;
  gap: 0.6rem;
  flex-wrap: wrap;
}

.product-card__price-compare {
  opacity: 0.5;
  text-decoration: line-through;
}

.product-card__price-sale {
  color: #a93226;
}

/* ================================================
   ARTICLE CARD
   ================================================ */

.article-card {
  display: flex;
  flex-direction: column;
  gap: 1.4rem;
}

.article-card__media-link {
  display: block;
  text-decoration: none;
  overflow: hidden;
}

.article-card__media {
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: rgba(0,0,0,0.04);
  border-radius: var(--style-card-radius, 0);
}

.article-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}

.article-card__media-link:hover .article-card__img {
  transform: scale(1.02);
}

.article-card__img--placeholder {
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.08);
}

.article-card__info {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.article-card__meta {
  font-size: 1.1rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.5;
}

.article-card__title {
  font-family: var(--font-body--family, sans-serif);
  font-size: 1.4rem;
  font-weight: 500;
  line-height: 1.35;
}

.article-card__title-link {
  text-decoration: none;
  color: currentColor;
}

.article-card__title-link:hover {
  text-decoration: underline;
  text-underline-offset: 0.3em;
}

.article-card__excerpt {
  font-size: 1.3rem;
  line-height: 1.6;
  opacity: 0.7;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ================================================
   PAGE RESULT (full-width horizontal card)
   ================================================ */

.page-result {
  display: flex;
  align-items: center;
  gap: 2rem;
  padding: 2rem 0;
  border-bottom: 1px solid var(--color-border);
  text-decoration: none;
}

.page-result__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.page-result__type {
  font-size: 1.1rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0.45;
}

.page-result__title {
  font-family: var(--font-body--family, sans-serif);
  font-size: 1.6rem;
  font-weight: 500;
  line-height: 1.3;
}

.page-result__title-link {
  text-decoration: none;
  color: currentColor;
}

.page-result__title-link:hover {
  text-decoration: underline;
  text-underline-offset: 0.3em;
}

.page-result__excerpt {
  font-size: 1.3rem;
  line-height: 1.6;
  opacity: 0.65;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 0.2rem;
}

.page-result__arrow {
  font-size: 2rem;
  opacity: 0.4;
  flex-shrink: 0;
  transition: opacity 0.15s ease, transform 0.2s ease;
}

.page-result:hover .page-result__arrow {
  opacity: 1;
  transform: translateX(4px);
}

/* ================================================
   EMPTY / NO RESULTS
   ================================================ */

.search-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2.4rem;
  padding: 4rem 0;
  text-align: center;
}

.search-empty__message {
  font-size: 1.5rem;
  opacity: 0.65;
  max-width: 44rem;
}

/* ================================================
   PAGINATION
   ================================================ */

.search-pagination {
  padding-top: 2rem;
}

.search-pagination__list {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.4rem;
  flex-wrap: wrap;
}

.search-pagination__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 4rem;
  height: 4rem;
  font-size: 1.4rem;
  text-decoration: none;
  color: var(--color-text);
  border: 1px solid transparent;
  transition: border-color 0.15s ease, background-color 0.15s ease;
  cursor: pointer;
}

.search-pagination__btn:hover {
  border-color: var(--color-border);
}

.search-pagination__btn.is-active {
  background: var(--color-text);
  color: var(--color-background);
  border-color: var(--color-text);
}

.search-pagination__btn--prev,
.search-pagination__btn--next {
  font-size: 1.8rem;
  width: auto;
  padding: 0 1rem;
}

.search-pagination__ellipsis {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 4rem;
  height: 4rem;
  font-size: 1.4rem;
  opacity: 0.4;
}

{% endstylesheet %}

{% javascript %}
(function () {
  /* Clear button wipes the input and refocuses */
  var clearBtn = document.getElementById('search-clear');
  var searchInput = document.getElementById('search-input');

  if (clearBtn && searchInput) {
    clearBtn.addEventListener('click', function () {
      searchInput.value = '';
      searchInput.focus();
    });
  }

  /* ---- QUICK ADD ---- */
  if (!window.__siennaQuickAdd) {
    window.__siennaQuickAdd = true;
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.product-card__quick-add-btn');
      if (!btn) return;
      var variantId = btn.dataset.variantId;
      if (!variantId) return;

      var origText = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Adding…';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ id: parseInt(variantId, 10), quantity: 1 })
      })
        .then(function (r) {
          if (!r.ok) throw new Error('Error');
          return fetch('/cart.js');
        })
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { item_count: cart.item_count } }));
          document.dispatchEvent(new CustomEvent('cart:open-drawer'));
          btn.textContent = 'Added!';
          setTimeout(function () { btn.textContent = origText; btn.disabled = false; }, 1800);
        })
        .catch(function () {
          btn.textContent = 'Error';
          setTimeout(function () { btn.textContent = origText; btn.disabled = false; }, 2000);
        });
    });
  }
})();
{% endjavascript %}

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Search"
    },
    {
      "type": "header",
      "content": "Results"
    },
    {
      "type": "select",
      "id": "results_per_page",
      "label": "Results per page",
      "options": [
        { "value": "12", "label": "12" },
        { "value": "24", "label": "24" },
        { "value": "48", "label": "48" }
      ],
      "default": "24"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
