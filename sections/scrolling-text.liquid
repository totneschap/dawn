{%- assign duration = section.settings.speed -%}

{%- if section.blocks.size > 0 -%}
<div class="scrolling-text full-width color-{{ section.settings.color_scheme }}" aria-hidden="true">
  <div
    class="scrolling-text__track"
    style="--scroll-duration: {{ duration }}s; --scroll-gap: {{ section.settings.gap }}rem;"
  >
    {%- comment -%}Render the list twice for seamless loop{%- endcomment -%}
    {%- for i in (1..2) -%}
      <ul class="scrolling-text__list" role="presentation">
        {%- for block in section.blocks -%}
          <li class="scrolling-text__item" {{ block.shopify_attributes }}>
            <span class="scrolling-text__text">{{ block.settings.text }}</span>
            {%- if section.settings.separator != blank -%}
              <span class="scrolling-text__sep" aria-hidden="true">{{ section.settings.separator }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</div>

{%- comment -%}Accessible static version for screen readers{%- endcomment -%}
<ul class="visually-hidden">
  {%- for block in section.blocks -%}
    <li>{{ block.settings.text }}</li>
  {%- endfor -%}
</ul>
{%- endif -%}

{% stylesheet %}

.scrolling-text {
  background-color: var(--color-background);
  color: var(--color-text);
  overflow: hidden;
  padding: 2rem 0;
}

.scrolling-text__track {
  display: flex;
  width: max-content;
  animation: scroll-text var(--scroll-duration, 30s) linear infinite;
  gap: var(--scroll-gap, 0rem);
}

.scrolling-text__list {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 0;
}

.scrolling-text__item {
  display: flex;
  align-items: center;
  white-space: nowrap;
  padding: 0;
}

.scrolling-text__text {
  font-family: var(--font-heading--family, serif);
  font-size: clamp(2rem, 3.5vw, 3.2rem);
  font-weight: 400;
  padding: 1.4rem 3rem;
  line-height: 1.2;
}

.scrolling-text__sep {
  font-size: 1.8rem;
  opacity: 0.4;
  flex-shrink: 0;
}

@keyframes scroll-text {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

@media (prefers-reduced-motion: reduce) {
  .scrolling-text__track {
    animation: none;
    flex-wrap: wrap;
    justify-content: center;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Scrolling text",
  "blocks": [
    {
      "type": "item",
      "name": "Text item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over £50"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator between items",
      "default": "·"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 30,
      "info": "Lower = faster."
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between items (rem)",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Scrolling text",
      "blocks": [
        { "type": "item", "settings": { "text": "Free shipping on orders over £50" } },
        { "type": "item", "settings": { "text": "New arrivals weekly" } },
        { "type": "item", "settings": { "text": "Made with care" } },
        { "type": "item", "settings": { "text": "Sustainable packaging" } }
      ],
      "settings": {
        "separator": "·",
        "speed": 30,
        "color_scheme": "scheme-3"
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
