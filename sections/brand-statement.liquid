<div
  class="brand-statement full-width color-{{ section.settings.color_scheme }}"
  style="text-align: {{ section.settings.text_align }};"
>
  <div class="brand-statement__inner">

    {%- if section.settings.label != blank -%}
      <p class="brand-statement__label">{{ section.settings.label }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2
        class="brand-statement__heading"
        style="font-size: clamp({{ section.settings.heading_size_min }}rem, {{ section.settings.heading_size_fluid }}vw, {{ section.settings.heading_size_max }}rem);"
      >{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="brand-statement__subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="brand-statement__cta">
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="button{% if section.settings.button_style == 'outline' %} button--outline{% endif %}"
        >{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}

.brand-statement {
  background-color: var(--color-background);
  color: var(--color-text);
  padding: var(--section-spacing, 6rem) 0;
}

.brand-statement__inner {
  max-width: var(--page-width, 120rem);
  margin: 0 auto;
  padding: 0 var(--page-margin, 2rem);
  display: flex;
  flex-direction: column;
  gap: 2.4rem;
  align-items: var(--bs-align, center);
}

/* align-items from text-align */
.brand-statement[style*="text-align: left"] .brand-statement__inner   { align-items: flex-start; }
.brand-statement[style*="text-align: right"] .brand-statement__inner  { align-items: flex-end; }
.brand-statement[style*="text-align: center"] .brand-statement__inner { align-items: center; }

.brand-statement__label {
  font-size: 1.1rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  opacity: 0.5;
}

.brand-statement__heading {
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: -0.01em;
  max-width: 20em;
}

.brand-statement__subtext {
  font-size: 1.6rem;
  line-height: 1.7;
  opacity: 0.7;
  max-width: 56ch;
}

.brand-statement__cta { margin-top: 0.8rem; }

{% endstylesheet %}

{% schema %}
{
  "name": "Brand statement",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "info": "Small uppercase text above the heading."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Statement",
      "default": "Refined fashion for the woman who knows her mind."
    },
    {
      "type": "header",
      "content": "Heading size"
    },
    {
      "type": "range",
      "id": "heading_size_min",
      "label": "Min size (mobile, rem)",
      "min": 2,
      "max": 6,
      "step": 0.5,
      "default": 3.5
    },
    {
      "type": "range",
      "id": "heading_size_fluid",
      "label": "Fluid size (vw)",
      "min": 3,
      "max": 12,
      "step": 0.5,
      "default": 5
    },
    {
      "type": "range",
      "id": "heading_size_max",
      "label": "Max size (desktop, rem)",
      "min": 4,
      "max": 16,
      "step": 0.5,
      "default": 7
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "filled",  "label": "Filled" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "outline"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Brand statement",
      "settings": {
        "heading": "Refined fashion for the woman who knows her mind.",
        "text_align": "center",
        "color_scheme": "scheme-2"
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
