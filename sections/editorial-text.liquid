{{ 'section-editorial-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  class="editorial-text color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if section.settings.full_height %} editorial-text--full-height{% endif %}{% if section.settings.parallax %} editorial-text--parallax{% endif %}{% if section.settings.image != blank %} editorial-text--has-image{% endif %}"
  id="EditorialText-{{ section.id }}"
>
  {%- if section.settings.image != blank -%}
    <div class="editorial-text__bg">
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          widths: '750, 1100, 1500, 2000, 3000, 3840',
          sizes: '100vw',
          loading: 'lazy',
          class: 'editorial-text__bg-img',
          fetchpriority: 'auto'
      }}
      <div class="editorial-text__bg-overlay" style="opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};"></div>
    </div>
  {%- endif -%}
  <div class="editorial-text__inner{% unless section.settings.full_width %} page-width{% endunless %} editorial-text--{{ section.settings.alignment }}">

    {%- if section.settings.eyebrow != blank -%}
      <p class="editorial-text__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="editorial-text__heading editorial-text__heading--{{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="editorial-text__subheading rte">{{ section.settings.subheading }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
      <div class="editorial-text__buttons">
        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="button{% if section.settings.button_style == 'secondary' %} button--secondary{% else %} button--primary{% endif %}"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a
            href="{{ section.settings.button_link_2 | default: '#' }}"
            class="button button--secondary"
          >
            {{ section.settings.button_label_2 | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{%- if section.settings.parallax -%}
<script>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var section = document.getElementById('EditorialText-{{ section.id }}');
    if (!section) return;
    var bgImg = section.querySelector('.editorial-text__bg-img');
    var inner = section.querySelector('.editorial-text__inner');

    var raf = null;
    var maxOffset = 60;

    function update() {
      var rect = section.getBoundingClientRect();
      var vh = window.innerHeight;
      var sectionCenter = rect.top + rect.height / 2;
      var dist = (sectionCenter - vh / 2) / (vh / 2 + rect.height / 2);
      if (dist > 1) dist = 1;
      if (dist < -1) dist = -1;
      var offset = (dist * maxOffset).toFixed(1) + 'px';
      if (bgImg) {
        bgImg.style.transform = 'translateY(' + offset + ')';
      } else if (inner) {
        inner.style.transform = 'translateY(' + offset + ')';
      }
      raf = null;
    }

    window.addEventListener('scroll', function () {
      if (!raf) raf = requestAnimationFrame(update);
    }, { passive: true });

    update();
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Editorial text",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "info": "Small uppercase label above the heading",
      "default": "New Collection"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Dressed for every moment"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" },
        { "value": "xl", "label": "Extra large" },
        { "value": "display", "label": "Display (full-width)" }
      ],
      "default": "xl"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading / body text"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "primary"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width (no page margin)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Full viewport height",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "Parallax scroll effect",
      "info": "Content scrolls at a slower rate, creating a depth effect",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "label": "Image overlay opacity",
      "info": "Dark overlay to improve text readability",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Editorial text",
      "settings": {
        "eyebrow": "New Collection",
        "heading": "Dressed for every moment",
        "heading_size": "xl",
        "alignment": "center"
      }
    }
  ]
}
{% endschema %}
