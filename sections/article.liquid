{%- liquid
  assign word_count = article.content | strip_html | split: ' ' | size
  assign read_time  = word_count | divided_by: 200.0 | ceil
-%}

<div class="article-page full-width color-{{ section.settings.color_scheme }}">

  <!-- ===== HERO IMAGE ===== -->
  {%- if article.image -%}
    <div class="article-hero">
      {%- assign hero_img_alt = article.image.alt | default: article.title | escape -%}
      {{ article.image | image_url: width: 2000 | image_tag:
        widths: '750, 1100, 1500, 2000',
        loading: 'eager',
        fetchpriority: 'high',
        width: article.image.width,
        height: article.image.height,
        alt: hero_img_alt,
        class: 'article-hero__img'
      }}
    </div>
  {%- endif -%}

  <div class="article-inner">

    <!-- ===== HEADER ===== -->
    <header class="article-header">

      <!-- Breadcrumb -->
      <nav class="article-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ blog.url }}" class="article-breadcrumb__link">{{ blog.title }}</a>
        <span aria-hidden="true">&nbsp;/&nbsp;</span>
        <span class="article-breadcrumb__current">{{ article.title | truncate: 55 }}</span>
      </nav>

      <h1 class="article-title">{{ article.title }}</h1>

      <div class="article-meta">
        {%- if section.settings.show_date -%}
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" class="article-meta__item">
            {{- article.published_at | date: '%d %B %Y' -}}
          </time>
        {%- endif -%}
        {%- if section.settings.show_author -%}
          <span class="article-meta__sep" aria-hidden="true">&middot;</span>
          <span class="article-meta__item">{{ article.author }}</span>
        {%- endif -%}
        {%- if section.settings.show_read_time -%}
          <span class="article-meta__sep" aria-hidden="true">&middot;</span>
          <span class="article-meta__item">{{ read_time }} min read</span>
        {%- endif -%}
      </div>

    </header>

    <!-- ===== BODY ===== -->
    <div class="article-body">
      <div class="rte article-rte">
        {{ article.content }}
      </div>

      <!-- Tags -->
      {%- if section.settings.show_tags and article.tags.size > 0 -%}
        <div class="article-tags">
          {%- for tag in article.tags -%}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article-tag">{{ tag }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Share -->
      {%- if section.settings.show_share -%}
        <div class="article-share">
          <button
            type="button"
            class="article-share__btn"
            id="article-share-btn"
            data-title="{{ article.title | escape }}"
          >
            Share this article
          </button>
        </div>
      {%- endif -%}
    </div>

    <!-- ===== PREVIOUS / NEXT ===== -->
    {%- if blog.next_article or blog.previous_article -%}
      <nav class="article-nav" aria-label="More articles">
        {%- if blog.previous_article -%}
          <a href="{{ blog.previous_article.url }}" class="article-nav__item article-nav__item--prev">
            <span class="article-nav__direction">&larr; Previous</span>
            <strong class="article-nav__title">{{ blog.previous_article.title }}</strong>
          </a>
        {%- else -%}
          <div></div>
        {%- endif -%}
        {%- if blog.next_article -%}
          <a href="{{ blog.next_article.url }}" class="article-nav__item article-nav__item--next">
            <span class="article-nav__direction">Next &rarr;</span>
            <strong class="article-nav__title">{{ blog.next_article.title }}</strong>
          </a>
        {%- else -%}
          <div></div>
        {%- endif -%}
      </nav>
    {%- endif -%}

  </div>

  <!-- ===== COMMENTS ===== -->
  {%- if blog.comments_enabled? -%}
    <div class="article-comments-wrap" id="comments">
      <div class="article-inner">

        {%- if article.comments_count > 0 -%}
          <h2 class="article-comments__heading">
            {{ article.comments_count }}
            {%- if article.comments_count == 1 %} comment{%- else %} comments{%- endif %}
          </h2>

          {%- paginate article.comments by 10 -%}
            <div class="article-comments__list">
              {%- for comment in article.comments -%}
                <div class="article-comment" id="comment-{{ comment.id }}">
                  <div class="article-comment__meta">
                    <strong class="article-comment__author">{{ comment.author }}</strong>
                    <time class="article-comment__date">
                      {{- comment.created_at | time_tag: format: 'date' -}}
                    </time>
                  </div>
                  <p class="article-comment__content">{{ comment.content }}</p>
                </div>
              {%- endfor -%}
            </div>
            {%- if paginate.pages > 1 -%}
              {{ paginate | default_pagination: anchor: 'comments' }}
            {%- endif -%}
          {%- endpaginate -%}
        {%- endif -%}

        {%- form 'new_comment', article -%}
          <div class="article-comment-form">
            <h2 class="article-comment-form__heading">{{ 'blog.comment_form_title' | t }}</h2>

            {%- if form.posted_successfully? -%}
              <p class="article-comment-form__success" role="status">
                Your comment has been submitted. It will appear once approved.
              </p>
            {%- else -%}

              {%- if form.errors -%}
                <div class="article-comment-form__errors" role="alert">
                  {{ form.errors | default_errors }}
                </div>
              {%- endif -%}

              <div class="article-comment-form__grid">
                <div class="article-comment-form__field">
                  <label class="article-comment-form__label" for="comment-author">
                    {{ 'blog.comment_form_name' | t }}
                  </label>
                  <input
                    type="text"
                    name="comment[author]"
                    id="comment-author"
                    class="article-comment-form__input"
                    value="{{ form.author }}"
                    autocomplete="name"
                    required
                  >
                </div>
                <div class="article-comment-form__field">
                  <label class="article-comment-form__label" for="comment-email">
                    {{ 'blog.comment_form_email' | t }}
                  </label>
                  <input
                    type="email"
                    name="comment[email]"
                    id="comment-email"
                    class="article-comment-form__input"
                    value="{{ form.email }}"
                    autocomplete="email"
                    required
                  >
                </div>
              </div>
              <div class="article-comment-form__field">
                <label class="article-comment-form__label" for="comment-body">
                  {{ 'blog.comment_form_body' | t }}
                </label>
                <textarea
                  name="comment[body]"
                  id="comment-body"
                  class="article-comment-form__textarea"
                  rows="6"
                  required
                >{{ form.body }}</textarea>
              </div>

              <button type="submit" class="button">
                {{ 'blog.comment_form_submit' | t }}
              </button>

            {%- endif -%}
          </div>
        {%- endform -%}

      </div>
    </div>
  {%- endif -%}

</div>

{% stylesheet %}

/* ================================================
   PAGE WRAPPER (full-width section)
   ================================================ */

.article-page {
  background-color: var(--color-background);
  color: var(--color-text);
  padding-bottom: 7rem;
}

/* ================================================
   HERO IMAGE
   ================================================ */

.article-hero {
  width: 100%;
  height: clamp(28rem, 45vw, 60rem);
  overflow: hidden;
}

.article-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ================================================
   INNER CONTENT (max-width constraint)
   ================================================ */

.article-inner {
  max-width: var(--page-width, 120rem);
  margin: 0 auto;
  padding: 0 var(--page-margin, 2rem);
}

/* ================================================
   HEADER
   ================================================ */

.article-header {
  max-width: 78ch;
  margin: 0 auto;
  padding: 5rem 0 3.6rem;
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

/* Breadcrumb */
.article-breadcrumb {
  font-size: 1.2rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.5;
}

.article-breadcrumb__link {
  text-decoration: none;
  color: currentColor;
}

.article-breadcrumb__link:hover {
  text-decoration: underline;
  text-underline-offset: 0.3em;
}

/* Title */
.article-title {
  font-size: clamp(var(--text-h3, 2.8rem), 5vw, var(--text-h1, 5.6rem));
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: -0.01em;
}

/* Meta */
.article-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.4rem;
  font-size: 1.3rem;
  opacity: 0.55;
}

.article-meta__sep {
  opacity: 0.5;
}

/* ================================================
   BODY (reading column)
   ================================================ */

.article-body {
  max-width: 72ch;
  margin: 0 auto;
  padding-bottom: 4.8rem;
  display: flex;
  flex-direction: column;
  gap: 3.2rem;
}

/* RTE reset within article */
.article-rte {
  font-size: 1.6rem;
  line-height: 1.8;
}

.article-rte h2 { font-size: var(--text-h3, 2.8rem); margin-top: 3.2rem; }
.article-rte h3 { font-size: var(--text-h4, 2.2rem); margin-top: 2.4rem; }
.article-rte p  { margin-bottom: 1.8rem; }
.article-rte p:last-child { margin-bottom: 0; }

/* Tags */
.article-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  padding-top: 0.8rem;
  border-top: 1px solid var(--color-border);
}

.article-tag {
  display: inline-block;
  padding: 0.4rem 1.2rem;
  border: 1px solid var(--color-border);
  font-size: 1.1rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-decoration: none;
  color: currentColor;
  opacity: 0.7;
  transition: opacity 0.15s ease, border-color 0.15s ease;
}

.article-tag:hover {
  opacity: 1;
  border-color: var(--color-text);
}

/* Share */
.article-share {
  display: flex;
}

.article-share__btn {
  background: none;
  border: 1px solid var(--color-border);
  font-family: var(--font-body--family, sans-serif);
  font-size: 1.2rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: currentColor;
  cursor: pointer;
  padding: 1rem 2rem;
  transition: border-color 0.15s ease, background-color 0.15s ease;
}

.article-share__btn:hover {
  border-color: var(--color-text);
  background: var(--color-text);
  color: var(--color-background);
}

/* ================================================
   PREV / NEXT NAV
   ================================================ */

.article-nav {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  border-top: 1px solid var(--color-border);
  padding-top: 3.2rem;
  margin-top: 4rem;
}

.article-nav__item {
  text-decoration: none;
  color: currentColor;
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  transition: opacity 0.15s ease;
}

.article-nav__item:hover { opacity: 0.65; }

.article-nav__item--next {
  text-align: right;
}

.article-nav__direction {
  font-size: 1.1rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0.5;
}

.article-nav__title {
  font-family: var(--font-heading--family, serif);
  font-size: 1.6rem;
  font-weight: 400;
  line-height: 1.3;
}

@media screen and (max-width: 749px) {
  .article-nav__title {
    font-size: 1.4rem;
  }
}

/* ================================================
   COMMENTS
   ================================================ */

.article-comments-wrap {
  border-top: 1px solid var(--color-border);
  margin-top: 3.2rem;
  padding-top: 4.8rem;
}

.article-comments__heading {
  font-size: var(--text-h3, 2.8rem);
  font-weight: 400;
  margin-bottom: 3.2rem;
}

.article-comments__list {
  display: flex;
  flex-direction: column;
  gap: 2.4rem;
  margin-bottom: 4.8rem;
}

.article-comment {
  padding-bottom: 2.4rem;
  border-bottom: 1px solid var(--color-border);
}

.article-comment__meta {
  display: flex;
  align-items: baseline;
  gap: 1.2rem;
  margin-bottom: 0.8rem;
}

.article-comment__author {
  font-size: 1.4rem;
  font-weight: 600;
}

.article-comment__date {
  font-size: 1.2rem;
  opacity: 0.5;
}

.article-comment__content {
  font-size: 1.5rem;
  line-height: 1.7;
}

/* Comment form */
.article-comment-form {
  max-width: 64rem;
}

.article-comment-form__heading {
  font-size: var(--text-h3, 2.8rem);
  font-weight: 400;
  margin-bottom: 2.8rem;
}

.article-comment-form__success {
  background: rgba(0,0,0,0.05);
  border-left: 3px solid var(--color-text);
  padding: 1.4rem 1.6rem;
  font-size: 1.4rem;
}

.article-comment-form__errors {
  margin-bottom: 2rem;
}

.article-comment-form__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.6rem;
  margin-bottom: 1.6rem;
}

@media screen and (max-width: 749px) {
  .article-comment-form__grid {
    grid-template-columns: 1fr;
  }
}

.article-comment-form__field {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  margin-bottom: 1.6rem;
}

.article-comment-form__field:last-of-type {
  margin-bottom: 2rem;
}

.article-comment-form__label {
  font-size: 1.2rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.7;
}

.article-comment-form__input,
.article-comment-form__textarea {
  background: none;
  border: 1px solid var(--color-border);
  border-radius: var(--style-input-radius, 0);
  color: var(--color-text);
  font-family: var(--font-body--family, sans-serif);
  font-size: 1.4rem;
  padding: 1rem 1.2rem;
  width: 100%;
  transition: border-color 0.15s ease;
}

.article-comment-form__input:focus,
.article-comment-form__textarea:focus {
  outline: none;
  border-color: var(--color-text);
}

.article-comment-form__textarea {
  resize: vertical;
  line-height: 1.6;
}

{% endstylesheet %}

{% javascript %}
(function () {
  var shareBtn = document.getElementById('article-share-btn');
  if (!shareBtn) return;

  shareBtn.addEventListener('click', function () {
    var title = shareBtn.dataset.title || document.title;
    var url   = window.location.href;

    if (navigator.share) {
      navigator.share({ title: title, url: url }).catch(function () {});
    } else if (navigator.clipboard) {
      navigator.clipboard.writeText(url).then(function () {
        var original = shareBtn.textContent;
        shareBtn.textContent = 'Link copied!';
        setTimeout(function () { shareBtn.textContent = original; }, 2000);
      });
    }
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Article",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Article header"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_read_time",
      "label": "Show reading time",
      "default": true
    },
    {
      "type": "header",
      "content": "Article footer"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show share button",
      "default": true
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
