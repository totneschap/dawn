<div class="password-page color-{{ section.settings.color_scheme }}">
  <div class="password-page__inner">

    <!-- Logo / shop name -->
    <div class="password-page__logo">
      {%- if settings.logo -%}
        {{ settings.logo | image_url: width: 300 | image_tag:
          alt: shop.name,
          class: 'password-page__logo-img',
          loading: 'eager'
        }}
      {%- else -%}
        <p class="password-page__shop-name">{{ shop.name }}</p>
      {%- endif -%}
    </div>

    <!-- Heading -->
    <h1 class="password-page__title">{{ 'password.title' | t }}</h1>

    {%- if shop.password_message != blank -%}
      <p class="password-page__message">{{ shop.password_message }}</p>
    {%- elsif section.settings.subtext != blank -%}
      <p class="password-page__message">{{ section.settings.subtext }}</p>
    {%- endif -%}

    <!-- Password form -->
    {%- form 'storefront_password' -%}

      {%- if form.errors -%}
        <div class="password-page__error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="password-page__form">
        <label for="password-input" class="visually-hidden">
          {{ 'password.password' | t }}
        </label>
        <div class="password-page__field">
          <input
            type="password"
            name="password"
            id="password-input"
            class="password-page__input"
            placeholder="{{ 'password.password' | t }}"
            autocomplete="current-password"
            required
          >
          <button type="submit" class="button password-page__submit">
            {{ 'password.enter' | t }}
          </button>
        </div>
      </div>

    {%- endform -%}

    <!-- Social links -->
    <div class="password-page__social">
      {%- if settings.social_instagram_link != blank -%}
        <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" class="password-page__social-link" aria-label="Instagram">
          {{- 'icon-instagram.svg' | inline_asset_content -}}
        </a>
      {%- endif -%}
      {%- if settings.social_tiktok_link != blank -%}
        <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" class="password-page__social-link" aria-label="TikTok">
          {{- 'icon-tiktok.svg' | inline_asset_content -}}
        </a>
      {%- endif -%}
      {%- if settings.social_facebook_link != blank -%}
        <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" class="password-page__social-link" aria-label="Facebook">
          {{- 'icon-facebook.svg' | inline_asset_content -}}
        </a>
      {%- endif -%}
      {%- if settings.social_pinterest_link != blank -%}
        <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener" class="password-page__social-link" aria-label="Pinterest">
          {{- 'icon-pinterest.svg' | inline_asset_content -}}
        </a>
      {%- endif -%}
    </div>

    <p class="password-page__powered">{{ powered_by_link }}</p>

  </div>
</div>

{% stylesheet %}

/* ================================================
   PASSWORD PAGE
   ================================================ */

.password-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rem 2rem;
  background-color: var(--color-background);
  color: var(--color-text);
}

.password-page__inner {
  max-width: 42rem;
  width: 100%;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2.4rem;
}

/* Logo */
.password-page__logo-img {
  max-width: 16rem;
  height: auto;
  display: block;
}

.password-page__shop-name {
  font-family: var(--font-heading--family, serif);
  font-size: 2.8rem;
  font-weight: 400;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

/* Heading */
.password-page__title {
  font-size: clamp(2.4rem, 5vw, var(--text-h2, 3.6rem));
  font-weight: 400;
  line-height: 1.15;
}

/* Subtext */
.password-page__message {
  font-size: 1.5rem;
  line-height: 1.7;
  opacity: 0.65;
  max-width: 36rem;
}

/* Error */
.password-page__error {
  width: 100%;
  text-align: left;
  font-size: 1.3rem;
  border-left: 3px solid #a93226;
  padding: 1rem 1.4rem;
  background: rgba(169, 50, 38, 0.06);
}

/* Form */
.password-page__form {
  width: 100%;
}

.password-page__field {
  display: flex;
  border: 1px solid var(--color-border);
  width: 100%;
}

.password-page__field:focus-within {
  outline: 2px solid var(--color-text);
  outline-offset: -1px;
}

.password-page__input {
  flex: 1;
  height: 5.2rem;
  background: none;
  border: none;
  outline: none;
  padding: 0 1.4rem;
  font-family: var(--font-body--family, sans-serif);
  font-size: 1.4rem;
  color: var(--color-text);
  min-width: 0;
}

.password-page__input::placeholder { opacity: 0.45; }

.password-page__submit {
  height: 5.2rem;
  padding: 0 2.2rem;
  font-size: 1.3rem;
  border-radius: 0;
  flex-shrink: 0;
}

/* Social */
.password-page__social {
  display: flex;
  justify-content: center;
  gap: 1.6rem;
  margin-top: 0.8rem;
}

.password-page__social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.2rem;
  height: 2.2rem;
  color: var(--color-text);
  opacity: 0.5;
  transition: opacity 0.15s ease;
}

.password-page__social-link:hover { opacity: 1; }

.password-page__social-link svg {
  width: 2rem;
  height: 2rem;
}

/* Powered by */
.password-page__powered {
  font-size: 1.1rem;
  opacity: 0.35;
}

.password-page__powered a {
  color: currentColor;
}

{% endstylesheet %}

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "info": "Shown when no password message is set in Shopify admin.",
      "default": "We're working on something special. Enter the password to get early access."
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
