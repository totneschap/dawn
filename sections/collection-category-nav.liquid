{{ 'section-collection-category-nav.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="collection-category-nav color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-category-nav__inner{% unless section.settings.full_width %} page-width{% endunless %} section-{{ section.id }}-padding">
    <ul class="collection-category-nav__list" role="list">
      {%- for col in collections -%}
        {%- unless col.handle == 'all' -%}
          {%- assign is_active = false -%}
          {%- if collection and collection.handle == col.handle -%}
            {%- assign is_active = true -%}
          {%- endif -%}
          <li>
            <a
              href="{{ col.url }}"
              class="collection-category-nav__link{% if is_active %} collection-category-nav__link--active{% endif %}"
              {% if is_active %}aria-current="page"{% endif %}
            >
              <div class="collection-category-nav__image-wrapper">
                {%- if col.featured_image != blank -%}
                  {{
                    col.featured_image
                    | image_url: width: 600
                    | image_tag:
                      class: 'collection-category-nav__image',
                      loading: 'lazy',
                      widths: '200, 300, 400, 600',
                      sizes: '(min-width: 990px) 22vw, 50vw'
                  }}
                {%- else -%}
                  <div class="collection-category-nav__image-placeholder"></div>
                {%- endif -%}
              </div>
              <span class="collection-category-nav__label">{{ col.title | escape }}</span>
            </a>
          </li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Category navigation",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width layout",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Category navigation"
    }
  ]
}
{% endschema %}
