{%- liquid
  assign img_pos = section.settings.image_position
  assign split   = section.settings.column_split

  case split
    when '50-50'
      assign col_image = '1fr'
      assign col_text  = '1fr'
    when '60-40'
      assign col_image = '1.5fr'
      assign col_text  = '1fr'
    when '40-60'
      assign col_image = '1fr'
      assign col_text  = '1.5fr'
  endcase
-%}

<div
  class="image-with-text full-width color-{{ section.settings.color_scheme }}"
  style="
    --iwt-col-image: {{ col_image }};
    --iwt-col-text:  {{ col_text }};
  "
>
  <div class="image-with-text__grid{% if img_pos == 'right' %} image-with-text__grid--reverse{% endif %}">

    <!-- Image -->
    <div
      class="image-with-text__media{% if section.settings.parallax %} image-with-text__media--parallax{% endif %}"
      data-parallax-id="{{ section.id }}"
    >
      {%- if section.settings.image != blank -%}
        {%- assign iwt_img_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag:
          widths: '600, 800, 1000, 1400',
          loading: 'lazy',
          width: section.settings.image.width,
          height: section.settings.image.height,
          alt: iwt_img_alt,
          class: 'image-with-text__img'
        }}
      {%- else -%}
        <div class="image-with-text__placeholder"></div>
      {%- endif -%}
    </div>

    <!-- Text -->
    <div
      class="image-with-text__content image-with-text__content--{{ section.settings.vertical_align }}"
      style="text-align: {{ section.settings.text_align }};"
    >
      {%- if section.settings.label != blank -%}
        <p class="image-with-text__label">{{ section.settings.label }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="image-with-text__heading image-with-text__heading--{{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="rte image-with-text__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="button{% if section.settings.button_style == 'outline' %} button--outline{% endif %} image-with-text__btn"
        >{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>

  </div>
</div>

{% stylesheet %}

.image-with-text {
  background-color: var(--color-background);
  color: var(--color-text);
}

/* Grid */
.image-with-text__grid {
  display: grid;
  grid-template-columns: 1fr;
  min-height: 40rem;
}

@media screen and (min-width: 750px) {
  .image-with-text__grid {
    grid-template-columns: var(--iwt-col-image, 1fr) var(--iwt-col-text, 1fr);
    min-height: 52rem;
  }

  .image-with-text__grid--reverse > :first-child {
    order: 2;
  }
  .image-with-text__grid--reverse > :last-child {
    order: 1;
  }
}

/* Media */
.image-with-text__media {
  overflow: hidden;
  position: relative;
  min-height: 32rem;
}

@media screen and (max-width: 749px) {
  .image-with-text__media { min-height: 40rem; }
}

.image-with-text__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  position: absolute;
  inset: 0;
}

/* Parallax: image is taller than container so it has room to travel */
.image-with-text__media--parallax .image-with-text__img {
  height: 115%;
  top: -7.5%;
  will-change: transform;
}

@media (prefers-reduced-motion: reduce) {
  .image-with-text__media--parallax .image-with-text__img {
    height: 100%;
    top: 0;
    will-change: auto;
  }
}

.image-with-text__placeholder {
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.07);
  position: absolute;
  inset: 0;
}

/* Content */
.image-with-text__content {
  padding: 5rem var(--page-margin, 2rem);
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.image-with-text__content--top    { justify-content: flex-start; }
.image-with-text__content--center { justify-content: center; }
.image-with-text__content--bottom { justify-content: flex-end; }

@media screen and (min-width: 750px) {
  .image-with-text__content {
    padding: 6rem clamp(3rem, 6vw, 7rem);
  }
}

.image-with-text__label {
  font-size: 1.1rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  opacity: 0.5;
}

.image-with-text__heading {
  font-weight: 400;
  line-height: 1.1;
}

.image-with-text__heading--small  { font-size: clamp(2.4rem, 3vw, 3.2rem); }
.image-with-text__heading--medium { font-size: clamp(3rem,   4vw, 4.4rem); }
.image-with-text__heading--large  { font-size: clamp(4rem,   5vw, 5.6rem); }

.image-with-text__text {
  font-size: 1.5rem;
  line-height: 1.75;
  max-width: 50ch;
}

.image-with-text__btn {
  align-self: flex-start;
}

.image-with-text__content[style*="text-align: center"] .image-with-text__btn,
.image-with-text__content[style*="text-align: right"] .image-with-text__btn {
  align-self: center;
}

{% endstylesheet %}

{% javascript %}
(function () {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var medias = document.querySelectorAll('.image-with-text__media--parallax');
  if (!medias.length) return;

  var ticking = false;

  function update() {
    var vh = window.innerHeight;
    medias.forEach(function (media) {
      var img = media.querySelector('.image-with-text__img');
      if (!img) return;
      var rect = media.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > vh) return;
      // progress: 0 when section bottom hits viewport bottom, 1 when section top hits viewport top
      var progress = (vh - rect.top) / (vh + rect.height);
      // shift between -7.5% and +7.5% (stays within the 115% image height)
      var shift = (progress - 0.5) * 15;
      img.style.transform = 'translateY(' + shift + '%)';
    });
    ticking = false;
  }

  window.addEventListener('scroll', function () {
    if (!ticking) {
      requestAnimationFrame(update);
      ticking = true;
    }
  }, { passive: true });

  update();
})();
{% endjavascript %}

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "Enable parallax scrolling",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "column_split",
      "label": "Column split",
      "options": [
        { "value": "50-50", "label": "50 / 50" },
        { "value": "60-40", "label": "60 / 40 (image larger)" },
        { "value": "40-60", "label": "40 / 60 (text larger)" }
      ],
      "default": "50-50"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "info": "Small uppercase text above the heading."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Our story"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small",  "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large",  "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Share your brand story, product features, or editorial content alongside a striking image.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "filled",  "label": "Filled" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "outline"
    },
    {
      "type": "header",
      "content": "Alignment"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical alignment",
      "options": [
        { "value": "top",    "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "settings": {
        "heading": "Our story",
        "text": "<p>Share your brand story, product features, or editorial content alongside a striking image.</p>",
        "image_position": "left",
        "column_split": "50-50",
        "heading_size": "medium"
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
