{{ 'section-split-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  class="split-content color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if section.settings.image_swap %} split-content--swapped{% endif %}{% if section.settings.full_bleed_image %} split-content--full-bleed{% endif %}"
  id="SplitContent-{{ section.id }}"
>
  <div class="split-content__grid{% if section.settings.full_width %} split-content--full-width{% else %} page-width{% endif %}">

    <!-- Image panel -->
    <div class="split-content__media">
      {%- if section.settings.image != blank -%}
        <div class="split-content__image-wrap split-content__image-wrap--{{ section.settings.image_ratio }}">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              widths: '400, 600, 800, 1000, 1200',
              loading: 'lazy',
              class: 'split-content__img',
              sizes: '(min-width: 990px) 50vw, 100vw'
          }}
        </div>
      {%- else -%}
        <div class="split-content__image-wrap split-content__image-wrap--{{ section.settings.image_ratio }}">
          {{ 'collection-2' | placeholder_svg_tag: 'split-content__placeholder' }}
        </div>
      {%- endif -%}
    </div>

    <!-- Text panel -->
    <div class="split-content__text split-content__text--{{ section.settings.text_align_v }}">
      <div class="split-content__text-inner">

        {%- if section.settings.eyebrow != blank -%}
          <p class="split-content__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="split-content__heading split-content__heading--{{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="split-content__body rte">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
          <div class="split-content__buttons">
            {%- if section.settings.button_label != blank -%}
              <a
                href="{{ section.settings.button_link | default: '#' }}"
                class="button{% if section.settings.button_style == 'secondary' %} button--secondary{% else %} button--primary{% endif %}"
              >
                {{ section.settings.button_label | escape }}
              </a>
            {%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}
              <a
                href="{{ section.settings.button_link_2 | default: '#' }}"
                class="button button--secondary"
              >
                {{ section.settings.button_label_2 | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Split content",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "natural", "label": "Natural (image proportions)" }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Our Story"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "The craft behind the collection"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Share your brand story, describe a product in depth, or highlight what makes your collection special.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "primary"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "image_swap",
      "label": "Swap image and text positions",
      "default": false
    },
    {
      "type": "select",
      "id": "text_align_v",
      "label": "Text vertical alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "middle"
    },
    {
      "type": "checkbox",
      "id": "full_bleed_image",
      "label": "Full-bleed image (no padding around image)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width (no page margins on desktop)",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Split content",
      "settings": {
        "eyebrow": "Our Story",
        "heading": "The craft behind the collection",
        "heading_size": "md",
        "image_ratio": "portrait",
        "full_bleed_image": true
      }
    }
  ]
}
{% endschema %}
