{%- if section.blocks.size > 0 -%}
<div class="social-feed full-width color-{{ section.settings.color_scheme }}">

  <!-- Header -->
  {%- if section.settings.heading != blank or section.settings.instagram_handle != blank -%}
    <div class="social-feed__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="social-feed__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.instagram_handle != blank -%}
        <a
          href="https://www.instagram.com/{{ section.settings.instagram_handle | remove: '@' }}/"
          class="social-feed__handle"
          target="_blank"
          rel="noopener"
        >@{{ section.settings.instagram_handle | remove: '@' }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <!-- Carousel track -->
  <div class="social-feed__carousel-wrap">
    <ul
      class="social-feed__track"
      id="social-feed-track-{{ section.id }}"
      role="list"
      style="--sf-cols: {{ section.settings.columns_mobile }}; --sf-cols-desktop: {{ section.settings.columns_desktop }};"
    >
      {%- for block in section.blocks -%}
        <li class="social-feed__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="social-feed__link" target="_blank" rel="noopener" aria-label="{{ block.settings.caption | default: 'View on Instagram' | escape }}">
          {%- endif -%}

          <div class="social-feed__media">
            {%- if block.settings.image != blank -%}
              {%- assign feed_img_alt = block.settings.caption | default: '' | escape -%}
              {{ block.settings.image | image_url: width: 800 | image_tag:
                widths: '400, 600, 800',
                loading: 'lazy',
                width: block.settings.image.width,
                height: block.settings.image.height,
                alt: feed_img_alt,
                class: 'social-feed__img'
              }}
            {%- else -%}
              <div class="social-feed__placeholder"></div>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <div class="social-feed__caption-overlay" aria-hidden="true">
                <p class="social-feed__caption">{{ block.settings.caption }}</p>
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    <!-- Navigation (shown when overflows) -->
    {%- if section.blocks.size > section.settings.columns_desktop -%}
      <button
        type="button"
        class="social-feed__nav social-feed__nav--prev"
        id="sf-prev-{{ section.id }}"
        aria-label="Previous"
      >&larr;</button>
      <button
        type="button"
        class="social-feed__nav social-feed__nav--next"
        id="sf-next-{{ section.id }}"
        aria-label="Next"
      >&rarr;</button>
    {%- endif -%}
  </div>

  {%- if section.settings.cta_label != blank and section.settings.instagram_handle != blank -%}
    <div class="social-feed__footer">
      <a
        href="https://www.instagram.com/{{ section.settings.instagram_handle | remove: '@' }}/"
        class="button button--outline social-feed__cta"
        target="_blank"
        rel="noopener"
      >{{ section.settings.cta_label }}</a>
    </div>
  {%- endif -%}

</div>
{%- endif -%}

{% stylesheet %}

.social-feed {
  background-color: var(--color-background);
  color: var(--color-text);
  padding: var(--section-spacing, 6rem) 0;
  overflow: hidden;
}

/* Header */
.social-feed__header {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 1.6rem;
  flex-wrap: wrap;
  text-align: center;
  padding: 0 var(--page-margin, 2rem);
  margin-bottom: 3.2rem;
}

.social-feed__heading {
  font-size: clamp(2.8rem, 4vw, 4rem);
  font-weight: 400;
  line-height: 1.1;
}

.social-feed__handle {
  font-size: 1.4rem;
  letter-spacing: 0.05em;
  opacity: 0.55;
  text-decoration: none;
  color: currentColor;
  transition: opacity 0.15s ease;
}

.social-feed__handle:hover { opacity: 1; }

/* Carousel wrap */
.social-feed__carousel-wrap {
  position: relative;
}

/* Track — scrollable list */
.social-feed__track {
  display: grid;
  grid-template-columns: repeat(var(--sf-cols, 2), calc((100vw - var(--page-margin, 2rem)) / var(--sf-cols, 2)));
  gap: 0.3rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding: 0 var(--page-margin, 2rem);
}

.social-feed__track::-webkit-scrollbar { display: none; }

@media screen and (min-width: 750px) {
  .social-feed__track {
    grid-template-columns: repeat(var(--sf-cols-desktop, 4), 1fr);
    overflow-x: visible;
    padding: 0;
  }
}

.social-feed__item {
  scroll-snap-align: start;
  flex-shrink: 0;
}

/* Media */
.social-feed__link {
  display: block;
  text-decoration: none;
}

.social-feed__media {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: rgba(0,0,0,0.06);
}

.social-feed__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.social-feed__placeholder {
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.08);
}

/* Caption overlay on hover */
.social-feed__caption-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  padding: 1.6rem;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.social-feed__link:hover .social-feed__img          { transform: scale(1.04); }
.social-feed__link:hover .social-feed__caption-overlay { opacity: 1; }

.social-feed__caption {
  font-size: 1.3rem;
  color: #fff;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Nav buttons (only shown if needed via JS visibility) */
.social-feed__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 4.4rem;
  height: 4.4rem;
  background: var(--color-background);
  color: var(--color-text);
  border: 1px solid var(--color-border);
  cursor: pointer;
  font-size: 1.6rem;
  display: none;
  align-items: center;
  justify-content: center;
  transition: background-color 0.15s ease;
  z-index: 2;
}

.social-feed__nav:hover {
  background: var(--color-text);
  color: var(--color-background);
}

.social-feed__nav--prev { left: 1.2rem; }
.social-feed__nav--next { right: 1.2rem; }

@media screen and (min-width: 750px) {
  .social-feed__nav { display: flex; }
}

/* Footer */
.social-feed__footer {
  text-align: center;
  padding: 3.2rem var(--page-margin, 2rem) 0;
}

{% endstylesheet %}

{% javascript %}
(function () {
  var track   = document.getElementById('social-feed-track-{{ section.id }}');
  var prevBtn = document.getElementById('sf-prev-{{ section.id }}');
  var nextBtn = document.getElementById('sf-next-{{ section.id }}');

  if (!track || !prevBtn || !nextBtn) return;

  function getScrollAmount() {
    var item = track.querySelector('.social-feed__item');
    return item ? item.offsetWidth + 3 : 320; /* item width + gap */
  }

  prevBtn.addEventListener('click', function () {
    track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
  });

  nextBtn.addEventListener('click', function () {
    track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Social feed",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Instagram post URL)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "info": "Shown on hover."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow our journey"
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram handle",
      "placeholder": "@siennaofficial"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Follow on Instagram"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    }
  ],
  "presets": [
    {
      "name": "Social feed",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ],
      "settings": {
        "heading": "Follow our journey",
        "cta_label": "Follow on Instagram",
        "columns_desktop": "4",
        "columns_mobile": "2"
      }
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
